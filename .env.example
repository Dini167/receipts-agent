# Copy this file to .env and fill in your own keys. Never commit .env.
# All four providers have free plans. You need at least one model key.

# 1. main model: Google AI Studio (https://aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# second Gemini model with the same key, used when the first is busy or slow
GEMINI_BACKUP_MODEL=gemini-flash-lite-latest,gemini-3.6-flash,gemma-4-26b-a4b-it

# 2. backup: Groq (https://console.groq.com). Check the current model names there.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_VISION_MODEL=

# 3. backup: OpenRouter (https://openrouter.ai). Pick models whose name ends with ":free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# 4. last backup: Ollama on your own computer (https://ollama.com). Leave empty to skip.
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# 0 = no brake (fast website). The evaluation script slows itself down automatically.
REQUESTS_PER_SECOND=0

# LangSmith (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=receipts-agent
